# Copy to apps/web/.env (git-ignored). Only VITE_* values reach the browser: never put secrets here.
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase public values only (anon/publishable key). Never the service-role key.
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
