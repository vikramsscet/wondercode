# Copy to apps/api/.env (git-ignored). Never commit real values.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Supabase (use the wondercode-dev project). SERVER-SIDE ONLY: never copy the service-role key into the web app.
# https://supabase.com/dashboard/project/zycimzspnnofsuzxkiwe
SUPABASE_URL=https://zycimzspnnofsuzxkiwe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Guest trial limits (defaults shown)
GUEST_TTL_MINUTES=120
GUEST_MAX_PROJECTS=2
GUEST_USAGE_LIMIT=10
GUEST_SESSIONS_PER_IP_PER_HOUR=10

# AI provider. "mock" needs no key and returns clearly labelled sample responses (default).
# openai / gemini / anthropic are reserved names; their adapters are not implemented yet.
AI_PROVIDER=mock
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=250
